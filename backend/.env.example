# Copy to .env at the repo root and fill in. Never commit the real .env.

# --- Database -------------------------------------------------------------
# Neon Postgres connection string. Must include ?sslmode=require.
# Driver prefix must be postgresql+psycopg:// (psycopg 3), not postgres://.
DATABASE_CONNECTION_STRING=postgresql+psycopg://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require

# --- Auth -----------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# This key is the tenancy boundary - company_id is a signed claim.
JWT_SECRET_KEY=change-me-generate-a-real-random-value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- App ------------------------------------------------------------------
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000

# --- Integrations (not used until step 2) ---------------------------------
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
# SLACK_SIGNING_SECRET=

# --- Knowledge layer (not used until step 7) ------------------------------
# HYDRA_API_KEY=
