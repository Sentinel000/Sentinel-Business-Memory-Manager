# Copy to .env at the repo root and fill in. Never commit the real .env.

# --- Database -------------------------------------------------------------
# Neon Postgres connection string. Must include ?sslmode=require.
# Driver prefix must be postgresql+psycopg:// (psycopg 3), not postgres://.
DATABASE_CONNECTION_STRING=postgresql+psycopg://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require

# --- Auth -----------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# This key is the tenancy boundary - company_id is a signed claim.
JWT_SECRET_KEY=change-me-generate-a-real-random-value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- App ------------------------------------------------------------------
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000

# --- Agent & LLM ----------------------------------------------------------
# Required. The Sentinel agent layer and meeting transcription both fail without it.
# Never put the real value in this file or anywhere else in the repo - .env only.
QWEN_API_KEY=
# OpenAI-compatible endpoint for the chat/agent model.
QWEN_API_BASE=https://your-workspace.region.maas.aliyuncs.com/compatible-mode/v1
AGENT_MODEL=qwen3.6-plus
# Confidence at or above which an extracted task auto-approves. 1.0 disables
# auto-approval entirely: everything waits in the founder queue.
AUTO_APPROVE_THRESHOLD_DEFAULT=1.0

# --- Email ----------------------------------------------------------------
# Optional. Empty SMTP_HOST disables email: reminders still appear in each
# employee's task view, they are just not sent. Any SMTP provider works -
# Alibaba Cloud DirectMail, Resend, SES, or Gmail with an app password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Port 465 usually means SMTP_USE_SSL=true. Otherwise STARTTLS is used.
SMTP_USE_SSL=false
EMAIL_FROM=Sentinel <sentinel@yourdomain.com>
# Where the web app is served. Links in emails point here.
APP_BASE_URL=http://localhost:3000
# How long a one-tap status link in an email stays valid.
ACTION_LINK_TTL_HOURS=168

# --- Integrations (not used until step 2) ---------------------------------
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
# SLACK_SIGNING_SECRET=

# --- Knowledge layer (not used until step 7) ------------------------------
# HYDRA_API_KEY=
